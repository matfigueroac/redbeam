<!DOCTYPE html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>RedBIM · Licencias de terceros</title>
<style>
    body { font: 16px system-ui, sans-serif; max-width: 76ch; margin: 2rem auto; padding: 0 1rem; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
<h1>RedBIM · Licencias de terceros</h1>
<ul>
{{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<section id="{{id}}">
    <h2>{{name}}</h2>
    <ul>
    {{#each used_by}}
        <li><a href="https://crates.io/crates/{{crate.name}}/{{crate.version}}">{{crate.name}} {{crate.version}}</a>{{#if path}} · {{path}}{{/if}}</li>
    {{/each}}
    </ul>
    <pre>{{text}}</pre>
</section>
{{/each}}
</html>
